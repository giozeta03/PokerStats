rules_version = '2';

// ============================================================================
// REGOLE DI SICUREZZA — Poker Tracker
//
// Logica:
// - Lettura pubblica e libera su tutte le collection (chiunque visualizza
//   classifica, recap e storico senza autenticarsi).
// - Scrittura (create/delete) consentita solo a utenti autenticati.
//   Nel nostro caso l'unico utente con credenziali sarai tu.
// - Nessun update mai consentito: una sessione sbagliata va cancellata
//   e reinserita, non modificata.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{playerId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }

    match /stats/{playerId} {
      allow read: if true;
      // gli stats vengono ricalcolati lato client per ora (vedi app.js);
      // quando si passerà alle Cloud Functions, questa regola potrà
      // restringersi ulteriormente (es. scrittura solo dal backend).
      allow write: if request.auth != null;
    }
  }
}
